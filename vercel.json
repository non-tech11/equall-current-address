{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [{ "source": "/", "destination": "/current_address", "permanent": false }],
  "rewrites": [
    { "source": "/current_address", "destination": "/index.html" },
    { "source": "/current_address/", "destination": "/index.html" },
    { "source": "/current_address_v2", "destination": "/v2.html" },
    { "source": "/current_address_v2/", "destination": "/v2.html" }
  ]
}
